<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ===================== -->
  <!-- Versioning            -->
  <!-- ===================== -->
  <PropertyGroup>

    <!-- Default version for local builds -->
    <BaseVersion Condition="'$(GITHUB_REF_NAME)' == ''">0.0.1</BaseVersion>

    <!-- Strip leading 'v' from Git tag -->
    <BaseVersion Condition="'$(GITHUB_REF_NAME)' != ''">
      $([System.String]::Copy('$(GITHUB_REF_NAME)').TrimStart('v'))
    </BaseVersion>

    <!-- Product / NuGet version -->
    <Version>$(BaseVersion)</Version>

    <!-- Informational version with commit SHA -->
    <InformationalVersion>$(BaseVersion)+$(GITHUB_SHA)</InformationalVersion>

    <!-- Assembly versions MUST be numeric -->
    <AssemblyVersion>
      $([System.Text.RegularExpressions.Regex]::Match('$(BaseVersion)','^\d+\.\d+\.\d+').Value).0
    </AssemblyVersion>

    <FileVersion>$(AssemblyVersion)</FileVersion>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Base configuration, included in build and publish output. --> 
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" /> 

    <!-- Development-specific override: only include if the file actually exists. Will not be included in publish output. -->
    <Content Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
